# Copy to .env.local and fill in. Never commit real values.
# The app checks these at startup and refuses to start if a required one is
# missing or invalid.

# Required. Encrypts NIC and KYC fields at rest: 32 bytes, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# The bank's own OpenRouter key (bring your own key). Server-side only; never
# shown, logged or sent to the browser. Without it, Settings shows "missing"
# and the assistant says it's unavailable. Also used by `pnpm eval`.
OPENROUTER_API_KEY=

# Confidence needed for an automatic outcome, in basis points (9500 = 95%).
# Below it, a loan officer decides. 0 to 10000. Default 9500.
AUTO_DECISION_THRESHOLD=9500

# Credit-score cache lifetime in days. 1 to 90 (never past the 90-day stale
# window). Default 30.
CREDIT_CACHE_TTL_DAYS=30

# true enables Settings changes and the demo controls (reset the government
# limit, clear the cache, mock failure mode). Off unless set to true.
# Must be false in production.
DEMO_MODE=true
