# Copy to .env.local and fill in. Never commit real values.

# Master key that encrypts the BYOK key and PII at rest (32 bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Password for the admin panel (BYOK key, per-agent models, threshold, demo controls).
ADMIN_PASSWORD=

# Demo controls: rate-limit reset and failure injection. Must be false in production.
DEMO_MODE=true

# Credit-score cache lifetime.
CREDIT_CACHE_TTL_DAYS=30

# Only for running evals from the CLI or CI. The app itself uses the BYOK key
# entered in the admin panel.
OPENROUTER_API_KEY=
